# Firebase Config (Frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (Backend)
FIREBASE_ADMIN_CREDENTIALS=

# MongoDB Connection
MONGODB_URI=

# Optional: override Node's DNS resolver for mongodb+srv:// SRV lookups.
# Only needed on dev machines whose system resolver can't do SRV queries
# (e.g. a dead 127.0.0.1 from a virtual adapter). Comma-separated. Leave unset
# in production. Example: DNS_SERVERS=1.1.1.1,8.8.8.8
DNS_SERVERS=

# JWT Secret Key
JWT_SECRET=

# AI Assistant (Invoice Parsing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
INVOICE_AI_PROVIDER=gemini

# Secret for the Vercel Cron keep-alive endpoint (/api/cron/keep-alive), which
# pings MongoDB on a schedule so the free-tier Atlas cluster is not paused for
# inactivity. Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
# Set it in the Vercel project's Environment Variables. Optional but recommended.
CRON_SECRET=

# Comma-separated emails that bootstrap to admin on their next VERIFIED login
# (e.g. ADMIN_EMAILS=you@example.com,ops@example.com). Only applied when Firebase
# has verified the token's email. Promotes only — it never demotes. Keep minimal:
# the trust root is "controls a verified mailbox on this list".
ADMIN_EMAILS=

# Timezone for the admin activity time-of-day heatmap. Mongo's $hour/$dayOfWeek
# default to UTC; set this to reflect real local activity, e.g. Asia/Kolkata.
# Defaults to UTC when unset.
APP_TZ=
