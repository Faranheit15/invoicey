# Firebase Config (Frontend)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (Backend)
FIREBASE_ADMIN_CREDENTIALS=

# MongoDB Connection
MONGODB_URI=

# Optional: override Node's DNS resolver for mongodb+srv:// SRV lookups.
# Only needed on dev machines whose system resolver can't do SRV queries
# (e.g. a dead 127.0.0.1 from a virtual adapter). Comma-separated. Leave unset
# in production. Example: DNS_SERVERS=1.1.1.1,8.8.8.8
DNS_SERVERS=

# JWT Secret Key
JWT_SECRET=

# AI Assistant (Invoice Parsing)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
INVOICE_AI_PROVIDER=gemini

# Durable per-user cap on AI assistant requests, counted over a ROLLING 24 hours
# (not a calendar day, so there is no midnight where a user can spend two days'
# budget at once). This is the real spend ceiling on the only endpoint that
# costs money per call — the burst limiter in the route is in-memory and so only
# per-lambda. Counted from the `ai.request` log entries, which are retained 30
# days. Counted from `ai.attempt` entries, written BEFORE the provider call —
# a call Gemini bills for but whose output fails to parse still spends a slot.
# Defaults to 50 when unset; set to 0 to disable the quota entirely.
INVOICE_AI_DAILY_LIMIT=50

# How many full-account data exports one user may take per rolling 24 hours.
# The export is an unpaginated read of every invoice they own, so it is the most
# expensive authenticated request in the app. Defaults to 3 when unset.
ACCOUNT_EXPORT_DAILY_LIMIT=3

# Keys the HMAC that turns a deleted account's uid into an audit pseudonym, so
# support can correlate "an account was deleted" without the row re-identifying
# the person it was about. Falls back to JWT_SECRET; with neither set the audit
# row records "unsalted" rather than an unkeyed digest, which would be
# reversible by anyone holding a list of uids.
ACCOUNT_AUDIT_SALT=

# Secret for the Vercel Cron keep-alive endpoint (/api/cron/keep-alive), which
# pings MongoDB on a schedule so the free-tier Atlas cluster is not paused for
# inactivity. Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
# Set it in the Vercel project's Environment Variables. Optional but recommended.
CRON_SECRET=

# Comma-separated emails that bootstrap to admin on their next VERIFIED login
# (e.g. ADMIN_EMAILS=you@example.com,ops@example.com). Only applied when Firebase
# has verified the token's email. Promotes only — it never demotes. Keep minimal:
# the trust root is "controls a verified mailbox on this list".
ADMIN_EMAILS=

# Timezone for the admin activity time-of-day heatmap. Mongo's $hour/$dayOfWeek
# default to UTC; set this to reflect real local activity, e.g. Asia/Kolkata.
# Defaults to UTC when unset.
APP_TZ=

# ---------------------------------------------------------------------------
# Sentry (error monitoring). ALL OPTIONAL: with no DSN the SDK is never
# initialised, nothing is sent, and the app builds and runs exactly as before.
# Creating the project and choosing its data region is an owner action — the
# region has to be recorded in the privacy policy's processor table.
# Set both DSNs to the same value; the NEXT_PUBLIC_ one is the browser's copy
# and is public by design (a DSN only permits writing events).
# ---------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ---------------------------------------------------------------------------
# Nightly backup (scripts/backup-to-r2.ts). These are GitHub Actions secrets,
# NOT Vercel environment variables — the backup deliberately runs outside the
# app's trust domain so a compromised deployment cannot reach the thing that
# recovers it. Listed here only so the names are discoverable; see
# docs/runbooks/backup-and-restore.md.
#
#   MONGODB_URI_BACKUP    read-only Atlas user, this database only
#   AGE_PUBLIC_KEY        age recipient; the PRIVATE key stays offline
#   R2_BUCKET             e.g. invoicey-backups
#   R2_ENDPOINT           https://<account-id>.r2.cloudflarestorage.com
#   R2_ACCESS_KEY_ID      write-only R2 token, scoped to that one bucket
#   R2_SECRET_ACCESS_KEY
# ---------------------------------------------------------------------------
